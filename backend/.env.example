# Chạy demo không cần Docker/PostgreSQL:
ENVIRONMENT=development
DATABASE_URL=sqlite:///./techcare.db
# Production có thể đổi thành PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/nckh_chatbot

OLLAMA_BASE_URL=http://localhost:11434
# Provider mặc định giữ cấu hình 3B hiện tại. Để dùng adapter 7B gốc:
# CHAT_PROVIDER=hf_lora
# HF_LORA_BASE_URL=http://127.0.0.1:8011
# Khởi động model_serving.server bằng môi trường GPU trước; xem docs/MODELS_AND_BENCHMARK.md.
CHAT_PROVIDER=ollama
# Đặt false nếu muốn dùng đúng model nền CHAT_MODEL thay vì profile 3B đã train.
# USE_PROJECT_CHAT_MODEL=false

CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

VECTOR_STORE_BACKEND=json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
AUTO_SEED=true
WARM_AI_ON_STARTUP=true
AI_RESPONSE_TIMEOUT_SECONDS=25
CHAT_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Bắt buộc thay trước khi đặt ENVIRONMENT=production:
SECRET_KEY=super_secret_key_change_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=techcare_rag
