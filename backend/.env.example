# Cấu hình tùy chọn cho demo local. Không cần đặt biến trong terminal.
# Nếu không có .env, app dùng SQLite backend/techcare.db và các default tương ứng.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./techcare.db
OLLAMA_BASE_URL=http://localhost:11434
# Model demo, embedding, CORS, seed và warm-up có default trong app/config.py.
# Chỉ cần khai báo thêm khi đổi cổng/dịch vụ hoặc dùng PostgreSQL.
# Không đặt ENVIRONMENT=production khi còn dùng tài khoản/secret mặc định.
