!techcare_eval_120.json
!techcare_chatbot_dataset.json
!techcare_train_pairs.jsonl
!techcare_qa_pairs.csv
!techcare_product_qa_500.csv

# Always keep local/generated artifacts out of Git.
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
vector_index.json
evaluation_results.json
curated_test_results.json

