# Ignore everything by default, then allow only code and runtime data.
*

# Git metadata for this allowlist.
!.gitignore

# Project instructions.
!README.md

# Source code.
!*.py

# Prompt and RAG knowledge sources.
!system_prompt.txt
!knowledge_base.md
!product_catalog_extended.md

# Important datasets used by chatbot, training, and evaluation.
!eval_questions.json
!techcare_rag_documents.json
